odeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250805233956-12tt7dc","updated":"20251006194809"},"Children":[{"ID":"20250805233956-jwkyqf4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250805233956-jwkyqf4","updated":"20251006194809"},"Children":[{"Type":"NodeText","Data":"有序列表 - 四级标题"}]}]},{"ID":"20250805233956-iie4ni4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250805233956-iie4ni4","updated":"20251006194810"},"Children":[{"ID":"20250805233956-f62a8eg","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250805233956-f62a8eg","updated":"20251006194810"},"Children":[{"Type":"NodeText","Data":"有序列表 - 五级标题"}]}]},{"ID":"20250805233956-6xjy89p","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20250805233956-6xjy89p","updated":"20251006194811"},"Children":[{"ID":"20250805233956-fhwqt8j","Type":"NodeHeading","HeadingLevel":6,"Properties":{"id":"20250805233956-fhwqt8j","updated":"20251006194811"},"Children":[{"Type":"NodeText","Data":"有序列表 - 六级标题"}]}]}]}]}]},{"ID":"20250805233956-8pyqycg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250805233956-8pyqycg","updated":"20251006194633"},"Children":[{"Type":"NodeText","Data":"特殊块测试"}]},{"ID":"20251006194124-jhuc258","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251006194124-jhuc258","updated":"20251006194618"},"Children":[{"Type":"NodeText","Data":"引述块"}]},{"ID":"20250805233956-t71o9gr","Type":"NodeBlockquote","Properties":{"id":"20250805233956-t71o9gr","updated":"20251006194052"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251006194049-4xmzpz9","Type":"NodeParagraph","Properties":{"id":"20251006194049-4xmzpz9","updated":"20251006194052"},"Children":[{"Type":"NodeText","Data":"引述块内容"}]},{"ID":"20251006194052-9oh1hdc","Type":"NodeParagraph","Properties":{"id":"20251006194052-9oh1hdc","updated":"20251006194052"},"Children":[{"Type":"NodeText","Data":"可以多行显示"}]}]},{"ID":"20250805233956-kd9qmjt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250805233956-kd9qmjt","updated":"20251006194621"},"Children":[{"Type":"NodeText","Data":"代码块"}]},{"ID":"20250805233956-uzxzzsx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250805233956-uzxzzsx","updated":"20250805233956"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"amF2YXNjcmlwdA=="},{"Type":"NodeCodeBlockCode","Data":"function test() {\n    console.log(\"Hello SiYuan\");\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250805233956-1y9u579","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250805233956-1y9u579","updated":"20251006194548"},"Children":[{"Type":"NodeText","Data":"动态内容测试"}]},{"ID":"20250805233956-k91ku2x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"custom-id":"20250805233956-k91ku2x","id":"20250805233956-k91ku2x","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"示例引用块："}]},{"ID":"20250805233956-itguj3j","Type":"NodeParagraph","Properties":{"id":"20250805233956-itguj3j","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"「实用测试」听上去并不复杂，对许多人也具有相当的吸引力。不过，「实用测试」也受到了很多哲学层面的非议。我们对此不详加讨论。简单地说，威廉・詹姆斯认为思想产生的结果的实际效用，决定了思想的意义和正确与否。一个问题即使无法被现实地加以解决，但它若可以影响人类的行为，那它就是一个「真」问题。由此可见，威廉强调的是结果而不是原因。在《宗教经验之种种》中，他确定无疑地说，宗教信仰与其他大脑状态无异，同样是受神经系统节制的。而且「它的重要性不应用它的原因来评价，而应用它的结果来评价」。所以，宗教即使不是绝对的「真理」，对每一个个体和人类整体来说，它仍然是有价值的。「真理」并非绝对领域，而是一个功能性的概念。思想作为工具才能体现价值，人们也只能用「工具主义」来评论它们。总而言之，「对人类有用的思想才称得上『真理』」。威廉・詹姆斯笔下的道德理想纯粹而至高无上；「有用」绝不是指经济利益；将作者的「实用主义」庸俗化地理解为「有用即有价值」显然是以偏概全的。"}]},{"ID":"20250805233956-b6ipomb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250805233956-b6ipomb","updated":"20251006194454"},"Children":[{"Type":"NodeText","Data":"示例嵌入块内容"}]},{"ID":"20250805233956-bay58ho","Type":"NodeParagraph","Properties":{"id":"20250805233956-bay58ho","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"一系列的「对话录」就是柏拉图一生思考的结晶。这些「对话录」长短不一，有的优美，有的枯燥，几乎都闪烁着苏格拉底之光。「苏格拉底方式」是那个时代的一种氛围。苏格拉底对一切发问，尤其是抽象的、重要的词汇被人们赋予的意义，比如正义、爱和勇敢。这些是真正的问题。真理只能经过智慧的竞争，通过「辩证法」的洗礼，才能得到。这种方法在对话中被证明和改进。这种方法不限于对人思维敏锐性的训练（排除极特殊情况），而是一种需要想象力的技术性工作，这种想象力需要人所有的诗性和戏剧性。阅读柏拉图和阅读莎士比亚（39）一样，是在阅读一位艺术家。"}]},{"ID":"20250805233956-al00p4i","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250805233956-al00p4i","updated":"20251006194500"},"Children":[{"Type":"NodeText","Data":"引用块"}]},{"ID":"20250805233956-tl3b3po","Type":"NodeParagraph","Properties":{"id":"20250805233956-tl3b3po","updated":"20251006194401"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250805233956-k91ku2x","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"「示例引用块」"}]},{"ID":"20251006194457-fy4ypq7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251006194457-fy4ypq7","updated":"20251006194532"},"Children":[{"Type":"NodeText","Data":"嵌入块："}]},{"ID":"20251006194532-n2gohll","Type":"NodeBlockQueryEmbed","Properties":{"id":"20251006194532-n2gohll","updated":"20251006194532"},"Children":[{"Type":"NodeOpenBrace"},{"Type":"NodeOpenBrace"},{"Type":"NodeBlockQueryEmbedScript","Data":"select * from blocks where id='20250805233956-b6ipomb'"},{"Type":"NodeCloseBrace"},{"Type":"NodeCloseBrace"}]},{"ID":"20250805233956-80fwhy9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250805233956-80fwhy9","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"数学公式测试"}]},{"ID":"20250805233956-evfvl2o","Type":"NodeParagraph","Properties":{"id":"20250805233956-evfvl2o","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"行内公式："},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"E = mc^2"},{"Type":"NodeText","Data":"\n"}]},{"ID":"20250805233956-re1mlog","Type":"NodeParagraph","Properties":{"id":"20250805233956-re1mlog","updated":"20250805233956"},"Children":[{"Type":"NodeText","Data":"块级公式："}]},{"ID":"20250805233956-qnbr606","Type":"NodeMathBlock","Properties":{"id":"20250805233956-qnbr606","updated":"20250805233956"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"\\begin{align*}\n\\nabla \\times \\mathbf{B} - \\frac{1}{c} \\frac{\\partial \\mathbf{E}}{\\partial t} \u0026= \\frac{4\\pi}{c} \\mathbf{j} \\\\\n\\nabla \\cdot \\mathbf{E} \u0026= 4\\pi \\rho \\\\\n\\nabla \\times \\mathbf{E} + \\frac{1}{c} \\frac{\\partial \\mathbf{B}}{\\partial t} \u0026= \\mathbf{0} \\\\\n\\nabla \\cdot \\mathbf{B} \u0026= 0 \\\\\n\\end{align*}"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20250805233956-p9mua24","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250805233956-p9mua24","updated":"20251006194955"},"Children":[{"Type":"NodeText","Data":"表格测试"}]},{"ID":"20250805233956-xoypkah","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20250805233956-xoypkah","updated":"20250805233956"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"项目"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"价格"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"数量"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"笔记本电脑"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"$1200"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"5"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"手机"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"$800"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"12"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"管线"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"$20"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"120"}]}]}]},{"ID":"20250805233956-qq5raef","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250805233956-qq5raef","updated":"20251006195008"},"Children":[{"Type":"NodeText","Data":"自定义 HTML 测试"}]},{"ID":"20250805234559-218bhr2","Type":"NodeHTMLBlock","Data":"\u003cdiv\u003e\n\u003cdiv class=\"custom-block\"\u003e\n    \u003ch3\u003eHTML 自定义区块\u003c/h3\u003e\n    \u003cbutton\u003e主按钮\u003c/button\u003e\n    \u003cbutton\u003e次按钮\u003c/button\u003e\n    \u003cdiv class=\"progress\"\u003e65% 完成\u003c/div\u003e\n    \u003cdiv class=\"alert\"\u003e⚠️ 这是一个自定义警告提示\u003c/div\u003e\n    \u003cinput type=\"text\" placeholder=\"输入测试...\"\u003e\n    \u003cbutton\u003e暗黑模式切换\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e","Properties":{"id":"20250805234559-218bhr2","updated":"20250805234611"}},{"ID":"20250805234611-g3mq8hy","Type":"NodeParagraph","Properties":{"id":"20250805234611-g3mq8hy","updated":"20250805234611"}}]}